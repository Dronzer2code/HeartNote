    <!-- Privacy sheet (content source: TRD § CONSENT AND DATA HANDLING) -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_not_stored_title">Never stored</string>
    <string name="privacy_not_stored">Camera frames and video. The camera is only used while you record, to read your pulse, breathing and expressions.</string>
    <string name="privacy_stored_title">Stored on this phone only</string>
    <string name="privacy_stored">Your voice, the Heartnote audio file, beat times, breathing curve, pulse-rate samples and smile moments.</string>
    <string name="privacy_sharing_title">Sharing</string>
    <string name="privacy_sharing">Only when you tap Share, and only the audio file. Signal data is never shared.</string>
    <string name="privacy_delete_title">Deleting</string>
    <string name="privacy_delete">Delete removes every file of a note. Uninstalling Heartnote removes all notes. Notes are not included in phone backups.</string>
    <string name="privacy_servers_title">Servers</string>
    <string name="privacy_servers">Heartnote has no servers and sends no data anywhere. The Presage SmartSpectra SDK that reads your pulse uses the internet to check the app\'s licence key; see Presage\'s privacy policy for what it sends.</string>

    <!-- About sheet -->
    <string name="about_title">About Heartnote</string>
    <string name="about_body">Heartnote records your voice while the front camera reads your pulse, then plays it back with a heartbeat sound and vibration timed to the beats you had while speaking. The heartbeat is synthesized at your measured beat times; it is not a stethoscope recording.</string>
